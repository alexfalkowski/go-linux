#!/usr/bin/env bash
# Preserve each CI lane's raw profile and merge the complete verification matrix.

set -eo pipefail

readonly reports_directory="test/reports"
readonly workspace_directory="/tmp/go-linux-reports"
readonly action="${1:-}"

case "$action" in
  stage)
    if [[ $# -ne 2 ]]; then
      printf 'usage: make coverage-workspace-stage partition=<facility>-<arch>\n' >&2
      exit 2
    fi

    readonly partition="$2"
    case "$partition" in
      rootless-arm64 | rootless-amd64 | netlink-arm64 | netlink-amd64 | mount-arm64 | mount-amd64 | fanotify-arm64 | fanotify-amd64 | timerfd-arm64 | timerfd-amd64) ;;
      *)
        printf 'partition must select rootless, netlink, mount, fanotify, or timerfd and arm64 or amd64\n' >&2
        exit 2
        ;;
    esac

    readonly profile="${reports_directory}/profile.cov"
    if [[ ! -f $profile || ! -s $profile || -L $profile ]]; then
      printf 'missing or empty coverage profile: %s\n' "$profile" >&2
      exit 1
    fi

    mkdir -p "${workspace_directory}/${partition}"
    cp "$profile" "${workspace_directory}/${partition}/profile.cov"
    ;;
  merge)
    if [[ $# -ne 1 ]]; then
      printf 'usage: make coverage-workspace-merge\n' >&2
      exit 2
    fi

    profiles=()
    for facility in rootless netlink mount fanotify timerfd; do
      for arch in arm64 amd64; do
        profile="${workspace_directory}/${facility}-${arch}/profile.cov"
        if [[ ! -f $profile || ! -s $profile || -L $profile ]]; then
          printf 'missing or empty coverage profile: %s\n' "$profile" >&2
          exit 1
        fi
        if ! awk 'NR == 1 && $0 != "mode: atomic" { exit 1 } END { if (NR < 2) exit 1 }' "$profile"; then
          printf 'expected a nonempty atomic coverage profile: %s\n' "$profile" >&2
          exit 1
        fi
        profiles+=("$profile")
      done
    done

    # Explicit raw inputs exclude old merged reports and unrelated artifacts.
    gocovmerge -o "${reports_directory}/profile.cov" "${profiles[@]}"
    ;;
  *)
    printf 'usage: scripts/coverage-workspace <stage|merge> [partition]\n' >&2
    exit 2
    ;;
esac
