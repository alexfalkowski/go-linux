#!/usr/bin/env bash
# Upload coverage from the Go image as the nonroot checkout owner.

set -eo pipefail

# shellcheck source=scripts/container.sh
source "$(dirname "$0")/container.sh"

if [[ $# -ne 1 || -z $1 ]]; then
  printf 'usage: make codecov-upload-container image=<tag>\n' >&2
  exit 2
fi

if [[ $(id -u) == 0 ]]; then
  printf 'coverage upload requires a nonroot invoking user\n' >&2
  exit 2
fi

coverage_image=$1

run_nonroot_container "$coverage_image" coverage \
  --env CI --env CIRCLECI --env CIRCLE_BRANCH --env CIRCLE_SHA1 \
  --env CIRCLE_PROJECT_USERNAME --env CIRCLE_PROJECT_REPONAME \
  --env CIRCLE_BUILD_NUM --env CIRCLE_BUILD_URL --env CIRCLE_JOB \
  --env CIRCLE_PULL_REQUEST --env CIRCLE_PR_NUMBER --env CIRCLE_WORKFLOW_ID \
  --env CODECOV_TOKEN \
  -- make codecov-upload
