#!/usr/bin/env bash
# Run required Netlink suites in private namespace children inside privileged Docker.

set -eo pipefail

# shellcheck source=scripts/container.sh
source "$(dirname "$0")/container.sh"

if [[ $# -ne 2 || -z $1 || ( $2 != amd64 && $2 != arm64 ) ]]; then
  printf 'usage: make verify-netlink-container image=<tag> arch=<amd64|arm64> [kernel=<supported|7.0|newer>]\n' >&2
  exit 2
fi

netlink_image=$1
netlink_arch=$2

printf 'executor=machine container=%s arch=%s privileged=true\n' "$netlink_image" "$netlink_arch"

run_privileged_container "$netlink_image" netlink "$netlink_arch" "kernel=${GO_LINUX_TEST_KERNEL:-supported}"
