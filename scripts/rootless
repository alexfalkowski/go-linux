#!/usr/bin/env bash
# Run rootless verification with a pinned Moby syscall profile on a native Linux Docker host.

set -eo pipefail

# shellcheck source=scripts/container.sh
source "$(dirname "$0")/container.sh"

if [[ $# -ne 2 || -z $1 || ( $2 != amd64 && $2 != arm64 ) ]]; then
  printf 'usage: make verify-rootless-container image=<tag> arch=<amd64|arm64> [package=<path>]\n' >&2
  exit 2
fi

if [[ $(id -u) == 0 ]]; then
  printf 'rootless verification requires a nonroot invoking user\n' >&2
  exit 2
fi

rootless_image=$1
rootless_arch=$2
rootless_profile=$(mktemp "${TMPDIR:-/tmp}/go-linux-seccomp.XXXXXX")
trap 'rm -f -- "$rootless_profile"' EXIT

# This default allowlist includes all four xattr-at calls; pin both its source
# revision and bytes so an upstream policy change cannot silently alter a run.
# https://github.com/moby/profiles/blob/f862455628f78f84c937e967e4a03902fb1dee11/seccomp/default.json
curl --fail --silent --show-error --location \
  --output "$rootless_profile" \
  https://raw.githubusercontent.com/moby/profiles/f862455628f78f84c937e967e4a03902fb1dee11/seccomp/default.json
printf '%s  %s\n' 3320527d4568265ac97a077609b1bfd4cfd0d789eeb9239b7e094b1526675406 "$rootless_profile" | sha256sum --check --status

printf 'executor=machine container=%s arch=%s privileged=false uid=%s seccomp=moby-f862455\n' "$rootless_image" "$rootless_arch" "$(id -u)"

run_nonroot_container "$rootless_image" rootless \
  --security-opt "seccomp=$rootless_profile" \
  --env package --env GO_LINUX_TEST_KERNEL \
  -- make verify-rootless "arch=$rootless_arch" "kernel=${GO_LINUX_TEST_KERNEL:-}"
