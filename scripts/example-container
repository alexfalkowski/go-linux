#!/usr/bin/env bash
# Run the container showcase on a native Linux Docker host with user namespaces.

set -eo pipefail

if [[ $# -ne 2 || -z $1 || ( -n $2 && $2 != true && $2 != false ) ]]; then
  printf 'usage: make example-container-docker image=<tag> [limits=true] [args=<JSON argv array>]\n' >&2
  exit 2
fi

docker run --quiet --rm --init --privileged --user root --cgroupns=private \
  --mount "type=bind,src=$PWD,dst=/work,readonly" --workdir /work \
  --env GO_LINUX_EXAMPLE_ARGS \
  -- "$1" bash -eo pipefail -c '
    if [[ $1 == true ]]; then
      if ! grep -qx "0::/" /proc/self/cgroup; then
        printf "example limits require a private v2 cgroup namespace rooted at the container\n" >&2
        exit 2
      fi
      mount --make-rprivate /
      mount -t cgroup2 none /sys/fs/cgroup
      mkdir /sys/fs/cgroup/runner
      mapfile -t example_pids < /sys/fs/cgroup/cgroup.procs
      for pid in "${example_pids[@]}"; do
        printf "%s\n" "$pid" > /sys/fs/cgroup/runner/cgroup.procs
      done
      printf "+memory +pids\n" > /sys/fs/cgroup/cgroup.subtree_control
      mkdir /sys/fs/cgroup/delegation
      printf "+memory +pids\n" > /sys/fs/cgroup/delegation/cgroup.subtree_control
      export GO_LINUX_EXAMPLE_CGROUP=/sys/fs/cgroup/delegation
    fi
    git config --global --add safe.directory /work
    exec make example-container "args=$GO_LINUX_EXAMPLE_ARGS"
  ' example-container "$2"
